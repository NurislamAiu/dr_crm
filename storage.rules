rules_version = '2';

// Целевые правила (Фаза 3). Медиа доступны только аутентифицированным менеджерам.
// Не деплоить до входа приложения через Firebase Auth.
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
