rules_version = '2';

// Строгие правила (Фаза 3 hardening). Доступ — только аутентифицированным
// менеджерам, у которых есть профиль users/{uid} (создаётся админом через
// createManager / bootstrapAdmins). Cloud Functions пишут через Admin SDK и
// правила обходят (webhook/отправка/медиа).
//
// Откат при проблемах: вернуть временно `allow read, write: if request.auth != null;`
// или test-режим и передеплоить.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isManager() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isManager()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'administrator'];
    }

    // Профили менеджеров: читают менеджеры, пишет только сервер (Admin SDK).
    // Свой профиль читает любой вошедший — иначе при пропавшем users/{uid}
    // вход отваливается непонятным «permission-denied» вместо ясной причины.
    match /users/{uid} {
      allow read: if isManager() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Контакты, диалоги, сообщения — только менеджеры.
    match /contacts/{id} {
      allow read, write: if isManager();
    }
    match /conversations/{id} {
      allow read, write: if isManager();
      // История назначений ответственного (Telegram): пишет только сервер.
      match /history/{hid} {
        allow read: if isManager();
        allow write: if false;
      }
    }
    match /messages/{id} {
      allow read, write: if isManager();
    }

    // Лиды / массаж / VIP-клиенты / счётчики / быстрые ответы — менеджеры.
    match /leads/{id} {
      allow read, write: if isManager();
    }
    match /massages/{id} {
      allow read, write: if isManager();
    }
    match /clients/{id} {
      allow read, write: if isManager();
    }
    match /counters/{id} {
      allow read, write: if isManager();
    }
    // Розыгрыш: картинку менеджеру ставит админ, читает менеджер только свою.
    match /pranks/{uid} {
      allow read: if isManager() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Шаблоны быстрых ответов общие для всех. Менеджер может добавить и
    // поправить, а удалить — только админ: удалённый шаблон пропадает сразу
    // у всех менеджеров (вместе с серверными вариантами текста к нему).
    match /quickReplies/{id} {
      allow read, create, update: if isManager();
      allow delete: if isAdmin();
    }

    // Настройки (автоответчик и т.п.) — только менеджеры.
    // config/risk (белый список номеров) правит только админ — иначе менеджер
    // мог бы сам себя вывести из-под контроля.
    // Канал (QR/WABA) и шаблоны WABA правит только админ — через функции.
    match /config/risk {
      allow read: if isManager();
      allow write: if isAdmin();
    }
    match /config/channel {
      allow read: if isManager();
      allow write: if false;
    }
    match /config/waba {
      allow read: if isManager();
      allow write: if false;
    }
    // Задержка «человечной» отправки WhatsApp (sendDelaySec) — правит админ:
    // менеджер не должен уметь выставить 0 и получить бан номера.
    match /config/wazzup {
      allow read: if isManager();
      allow write: if isAdmin();
    }
    // Автоответ WhatsApp на первое обращение — правит только админ:
    // это сообщения, которые уходят клиентам без участия менеджера.
    match /config/waAutoReply {
      allow read: if isManager();
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if isManager();
      allow write: if isManager() && !(id in ['risk', 'channel', 'waba', 'wazzup', 'waAutoReply']);
    }

    // Присутствие: читают менеджеры, пишет только сам о себе.
    match /presence/{uid} {
      allow read: if isManager();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Рабочие сессии (аналитика «когда зашёл/вышел»): читают менеджеры,
    // создаёт/обновляет каждый только свои (uid внутри документа).
    match /workSessions/{id} {
      allow read: if isManager();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // FCM-токены для пушей: каждый читает/пишет только свой документ
    // (чтение — для переключателя «Уведомления» в настройках).
    match /fcmTokens/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Активная сессия: один менеджер в системе (перезаписывает любой менеджер).
    match /sessions/{id} {
      allow read, write: if isManager();
    }

    // Рассылки отключены (2026-08-09): экран удалён из приложения, обработчик
    // снят с деплоя. Историю оставляем на чтение, создавать новые нельзя.
    match /broadcasts/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    // Контроль подозрительной активности: пишет только сервер (Admin SDK),
    // читает только админ — менеджеры свой журнал не видят и не правят.
    match /riskEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /riskState/{uid} {
      allow read, write: if false;
    }

    // Очередь отправки: менеджеры видят, сколько ждёт отправки; наполняет и
    // разбирает её только сервер.
    match /outbox/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    // Telegram: сырые апдейты вебхука (дедуп по update_id) — только сервер,
    // читать может админ для диагностики.
    match /tgUpdates/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Telegram: очередь ретраев отправки (429 retry_after) — только сервер.
    match /tgOutbox/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    // Удалённая диагностика устройств: каждый пишет только свой журнал,
    // читает админ (и сервер через tgSetup?action=clientlogs).
    match /clientLogs/{uid} {
      allow read: if isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Всё остальное — запрещено.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
