# ==========================================================================
# Wazzup User API v3 (WhatsApp QR-канал, transport=whatsapp)
# ==========================================================================
# ВНИМАНИЕ: WAZZUP_API_KEY — СЕКРЕТ. Только backend. Никогда не во frontend.
# Создавать NEXT_PUBLIC_WAZZUP_API_KEY — ЗАПРЕЩЕНО.
WAZZUP_API_BASE_URL=https://api.wazzup24.com
WAZZUP_API_KEY=
# Секрет, которым мы защищаем входящий webhook (проверяется как
# Authorization: Bearer <secret> и/или ?secret=<secret> в URL).
WAZZUP_WEBHOOK_SECRET=
# UUID канала WhatsApp (channelId из GET /v3/channels). Выбирается только на backend.
WAZZUP_CHANNEL_ID=
# Ожидаемый транспорт. Для QR-WhatsApp — всегда whatsapp (НЕ wapi).
WAZZUP_EXPECTED_TRANSPORT=whatsapp

# ==========================================================================
# Инфраструктура
# ==========================================================================
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
# Секрет для подписи сессий Auth.js (сгенерировать: openssl rand -base64 32)
AUTH_SECRET=

# ==========================================================================
# S3-совместимое хранилище (MinIO в dev)
# ==========================================================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=crm-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
